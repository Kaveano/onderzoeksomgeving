{
  // Configuratie voor Cloudflare (Wrangler). Bevat GEEN geheimen.
  // Het wachtwoord staat als geheim "BEHEER_WACHTWOORD" in Cloudflare (niet in dit bestand).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onderzoek",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Alleen deze paden starten de Worker; al het andere zijn gratis statische bestanden.
    "run_worker_first": ["/api/*", "/v/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onderzoeksomgeving",
      // Wordt ingevuld na het aanmaken van de database in de EU (jurisdictie "eu").
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Geen logboek bij Cloudflare: zo worden ook daar geen IP-adressen bewaard.
  "observability": { "enabled": false },
  "upload_source_maps": false
}
