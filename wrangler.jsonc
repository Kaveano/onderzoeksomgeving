{
  // Configuratie voor Cloudflare (Wrangler). Bevat GEEN geheimen.
  // Het wachtwoord staat als geheim "BEHEER_WACHTWOORD" in Cloudflare (niet in dit bestand).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onderzoek",
  "account_id": "cfaa94deaf3de79ed3a1c31385efdb80",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // De bestanden uit public/ worden bij het bouwen in de Worker gezet (scripts/bundel-statisch.mjs).
  "build": {
    "command": "node scripts/bundel-statisch.mjs",
    "watch_dir": "public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onderzoeksomgeving",
      // Aangemaakt met jurisdictie "eu": de database draait en bewaart gegevens alleen in de EU.
      "database_id": "5a9defc3-6fde-40d6-a8e1-bc0760063aa7",
      "migrations_dir": "migrations"
    }
  ],
  // Geen logboek bij Cloudflare: zo worden ook daar geen IP-adressen bewaard.
  "observability": { "enabled": false },
  "upload_source_maps": false
}
